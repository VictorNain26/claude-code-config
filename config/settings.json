{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm i)",
      "Bash(pnpm outdated*)",
      "Bash(pnpm why *)",
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm build*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm format*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec vitest *)",
      "Bash(bun install)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun test*)",
      "Bash(bun outdated*)",
      "Bash(uv sync)",
      "Bash(uv sync --frozen)",
      "Bash(uv lock)",
      "Bash(uv tree*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy*)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch --prune)",
      "Bash(git pull)",
      "Bash(git pull --ff-only)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)",
      "Bash(git stash push*)",
      "Bash(git worktree add *)",
      "Bash(git cherry-pick*)",
      "Bash(git commit -m*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh repo view*)",
      "Bash(glab mr view*)",
      "Bash(glab mr list*)",
      "Bash(glab mr diff*)",
      "Bash(glab issue view*)",
      "Bash(glab issue list*)",
      "Bash(glab ci list*)",
      "Bash(glab ci view*)",
      "Bash(glab ci status*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose build:*)",
      "Bash(docker build:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update*)",
      "Bash(bun add *)",
      "Bash(bun remove *)",
      "Bash(bun update*)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(uv lock --upgrade*)",
      "Bash(uv sync --upgrade*)",
      "Bash(pnpm dlx *)",
      "Bash(bun x *)",
      "Bash(bunx *)",
      "Bash(docker exec*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * --delete *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete*)",
      "Bash(git tag -d*)",
      "Bash(git tag --delete*)",
      "Bash(*--no-verify*)",
      "Bash(sudo rm *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(yarn publish*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh release create*)",
      "Bash(glab mr merge*)",
      "Bash(glab mr close*)",
      "Bash(glab release create*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.profile)",
      "Edit(.npmrc)",
      "Read(.npmrc)"
    ],
    "deny": [
      "Bash(chmod -R 777*)",
      "Bash(chmod 777 /*)",
      "Bash(dd if=*)",
      "Bash(mkfs*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(!.env.dist)",
      "Read(.envrc)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(credentials.json)",
      "Read(secrets.json)",
      "Read(secrets.yaml)",
      "Read(secrets.yml)",
      "Read(secrets.toml)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.ssh/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.azure/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.docker/config.json)",
      "Edit(~/.git-credentials)",
      "Edit(~/.netrc)",
      "Edit(~/.npmrc)",
      "Edit(~/.pypirc)",
      "Edit(~/.claude/.credentials.json)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "extraKnownMarketplaces": {
    "claude-code-config": {
      "source": {
        "source": "github",
        "repo": "VictorNain26/claude-code-config",
        "sparsePaths": [
          ".claude-plugin",
          "plugins"
        ]
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "engineering-standards@claude-code-config": true
  }
}
