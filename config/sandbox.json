{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "excludedCommands": [
      "docker compose ps *",
      "docker compose logs *",
      "docker compose config *",
      "docker compose build *",
      "docker build *",
      "docker ps *",
      "docker logs *",
      "docker inspect *"
    ],
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "pypi.org",
        "files.pythonhosted.org",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com"
      ]
    }
  }
}
