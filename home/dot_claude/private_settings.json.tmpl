{{- $host := get . "host" | default .chezmoi.hostname -}}
{{- if not (hasKey .claude.hosts $host) -}}
{{-   fail (printf "no Claude settings for host %q in .chezmoidata/claude.json (set data.host in chezmoi.toml to pick another key)" $host) -}}
{{- end -}}
{{- mergeOverwrite (deepCopy .claude.settings) (index .claude.hosts $host) | toPrettyJson }}
