{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "syncClaudeAiPlugins": false,
  "env": {
    "GHIDRA_INSTALL_DIR": "/home/ordiv/.local/opt/ghidra_12.1.4_PUBLIC",
    "REA_JADX_MCP_JAR": "/home/ordiv/.local/share/rea/android/jadx-headless-mcp-0.7.1-all.jar",
    "REA_APKTOOL_COMMAND": "/home/ordiv/.local/share/apktool/apktool"
  },
  "permissions": {
    "allow": [
      "Bash(victorserv claude *)"
    ],
    "deny": [
      "Read(~/**/.env)",
      "Read(~/**/.env.local)",
      "Read(~/**/.env.*.local)",
      "Read(~/**/.env.development)",
      "Read(~/**/.env.test)",
      "Read(~/**/.env.staging)",
      "Read(~/**/.env.production)",
      "Read(~/**/*.key)",
      "Read(~/**/*.p12)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/**/.dev.vars)",
      "Read(~/.docker/config.json)",
      "Read(~/.config/clever-cloud/**)",
      "Read(~/.config/.wrangler/config/**)",
      "Read(~/.local/share/com.vercel.cli/auth.json)",
      "Edit(**/.git/hooks/**)",
      "Edit(**/.git/config)",
      "Edit(~/.local/bin/**)",
      "Bash(ssh *victorserv*)",
      "Bash(git push *--receive-pack*)",
      "Bash(git push *--exec*)",
      "Bash(git fetch *--upload-pack*)",
      "Bash(git pull *--upload-pack*)"
    ],
    "ask": [
      "Bash(victorserv admin *)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*drop database*)",
      "Bash(*DROP SCHEMA*)",
      "Bash(*drop schema*)",
      "Bash(*TRUNCATE*)",
      "Bash(*truncate table*)",
      "Bash(dropdb *)",
      "Bash(*docker compose down -v*)",
      "Bash(*docker compose down --volumes*)",
      "Bash(*docker volume rm*)",
      "Bash(*docker system prune*)",
      "Bash(*wrangler deploy*)",
      "Bash(*vercel --prod*)",
      "Bash(*vercel deploy --prod*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(rm -r*)",
      "Bash(rm -R*)",
      "Bash(rm -f*r*)",
      "Bash(rm -f*R*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo deploy-key*)",
      "Bash(gh secret*)",
      "Bash(gh variable*)",
      "Bash(gh api *)"
    ]
  },
  "skillOverrides": {
    "chrome-browser": "off",
    "built-in-browser": "off",
    "computer-use": "off"
  },
  "deniedMcpServers": [
    {
      "serverName": "claude.ai Gmail"
    },
    {
      "serverName": "claude.ai Google Calendar"
    },
    {
      "serverName": "claude.ai Google Docs"
    },
    {
      "serverName": "claude.ai Google Drive"
    },
    {
      "serverName": "claude.ai Google Sheets"
    },
    {
      "serverName": "claude.ai Google Slides"
    }
  ],
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true,
    "cloudflare@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "rea@rea": true
  },
  "extraKnownMarketplaces": {
    "rea": {
      "source": {
        "source": "github",
        "repo": "morluto/rea"
      }
    }
  },
  "language": "french",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "bun.sh",
        "*.cloudflare.com",
        "*.vercel.com",
        "rubygems.org",
        "index.rubygems.org"
      ],
      "tlsTerminate": {}
    },
    "filesystem": {
      "allowWrite": [
        "~/.local/share/pnpm",
        "~/.cache",
        "~/.npm",
        "~/.bun/install"
      ],
      "denyWrite": [
        "~/.local/bin",
        "~/.config",
        "~/.npmrc",
        "~/.ssh",
        "~/.local/share/claude",
        "~/.local/share/mise"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "mask",
          "extract": "oauth_token:\\s*(\\S+)",
          "injectHosts": [
            "api.github.com",
            "github.com"
          ]
        }
      ]
    },
    "excludedCommands": [
      "docker ps *",
      "docker logs *",
      "docker inspect *",
      "victorserv admin *",
      "victorserv claude *",
      "git push",
      "git push origin *",
      "git push -u origin *",
      "git push --force-with-lease origin *",
      "git fetch",
      "git fetch origin*",
      "git fetch --prune origin*",
      "git pull --ff-only",
      "git pull --ff-only origin*"
    ]
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "showThinkingSummaries": true,
  "skipWorkflowUsageWarning": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
