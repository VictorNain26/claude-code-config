{
    "permissions":  {
                        "defaultMode":  "auto",
                        "allow":  [
                                      "Bash(pnpm *)",
                                      "Bash(bun *)",
                                      "Bash(npm run *)",
                                      "Bash(npx *)",
                                      "Bash(git status*)",
                                      "Bash(git log*)",
                                      "Bash(git diff*)",
                                      "Bash(git show*)",
                                      "Bash(git branch*)",
                                      "Bash(git fetch*)",
                                      "Bash(git pull*)",
                                      "Bash(git checkout*)",
                                      "Bash(git stash*)",
                                      "Bash(git rev-parse*)",
                                      "Bash(git rev-list*)",
                                      "Bash(git ls-files*)",
                                      "Bash(git ls-remote*)",
                                      "Bash(git worktree*)",
                                      "Bash(git cherry-pick*)",
                                      "Bash(git commit -m*)",
                                      "Bash(gh pr view*)",
                                      "Bash(gh pr list*)",
                                      "Bash(gh pr diff*)",
                                      "Bash(gh pr checks*)",
                                      "Bash(gh issue view*)",
                                      "Bash(gh issue list*)",
                                      "Bash(gh run view*)",
                                      "Bash(gh run list*)",
                                      "Bash(gh repo view*)",
                                      "Bash(gh api repos/*)",
                                      "WebFetch(domain:docs.mistral.ai)",
                                      "WebFetch(domain:docs.coderabbit.ai)",
                                      "WebFetch(domain:docs.renovatebot.com)",
                                      "WebFetch(domain:code.claude.com)",
                                      "WebFetch(domain:docs.claude.com)",
                                      "WebFetch(domain:docs.anthropic.com)",
                                      "WebFetch(domain:eslint.org)",
                                      "WebFetch(domain:devblogs.microsoft.com)",
                                      "WebFetch(domain:github.com)",
                                      "WebFetch(domain:www.npmjs.com)",
                                      "WebFetch(domain:registry.npmjs.org)",
                                      "WebFetch(domain:docs.expo.dev)",
                                      "WebFetch(domain:reactnative.dev)",
                                      "WebFetch(domain:nextjs.org)",
                                      "WebFetch(domain:elysiajs.com)",
                                      "WebFetch(domain:orm.drizzle.team)",
                                      "WebFetch(domain:better-auth.com)",
                                      "WebFetch(domain:supabase.com)",
                                      "WebFetch(domain:vercel.com)"
                                  ],
                        "deny":  [
                                     "Bash(git push --force*)",
                                     "Bash(git push --force-with-lease*)",
                                     "Bash(git push -f*)",
                                     "Bash(git push --no-verify*)",
                                     "Bash(git reset --hard origin/*)",
                                     "Bash(git reset --hard HEAD~*)",
                                     "Bash(git clean -fd*)",
                                     "Bash(git clean -fdx*)",
                                     "Bash(git branch -D *)",
                                     "Bash(git push origin --delete*)",
                                     "Bash(git tag -d*)",
                                     "Bash(git commit --amend*)",
                                     "Bash(git commit --no-verify*)",
                                     "Bash(git rebase --interactive*)",
                                     "Bash(git rebase -i*)",
                                     "Bash(git add .)",
                                     "Bash(git add -A)",
                                     "Bash(git add --all*)",
                                     "Bash(rm -rf *)",
                                     "Bash(rm -fr *)",
                                     "Bash(curl * | bash*)",
                                     "Bash(curl * | sh*)",
                                     "Bash(wget * | bash*)",
                                     "Read(./.env)",
                                     "Read(./.env.*)",
                                     "Read(**/.env)",
                                     "Read(**/.env.*)",
                                     "Read(**/*.pem)",
                                     "Read(**/*.key)",
                                     "Read(**/*.p12)",
                                     "Read(**/credentials.json)",
                                     "Read(**/secrets.*)"
                                 ],
                        "ask":  [
                                    "Bash(git push*)",
                                    "Bash(git merge*)",
                                    "Bash(gh pr merge*)",
                                    "Bash(gh pr close*)",
                                    "Bash(gh pr create*)",
                                    "Bash(gh release create*)"
                                ]
                    },
    "enabledPlugins":  {
                           "superpowers@claude-plugins-official":  true,
                           "commit-commands@claude-plugins-official":  true,
                           "feature-dev@claude-plugins-official":  true,
                           "javascript-typescript@claude-code-workflows":  true,
                           "expo-app-design@expo-plugins":  true,
                           "expo-deployment@expo-plugins":  true,
                           "upgrading-expo@expo-plugins":  true,
                           "context7@claude-plugins-official":  true,
                           "claude-md-management@claude-plugins-official":  true,
                           "security-guidance@claude-plugins-official":  true,
                           "code-review@claude-plugins-official":  true,
                           "github@claude-plugins-official":  true,
                           "typescript-lsp@claude-plugins-official":  true
                       },
    "extraKnownMarketplaces":  {
                                   "expo-plugins":  {
                                                        "source":  {
                                                                       "source":  "github",
                                                                       "repo":  "expo/skills"
                                                                   }
                                                    }
                               },
    "effortLevel":  "xhigh",
    "autoUpdatesChannel":  "latest",
    "inputNeededNotifEnabled":  true,
    "agentPushNotifEnabled":  true,
    "skipAutoPermissionPrompt":  true,
    "language":  "french",
    "spinnerTipsEnabled":  false,
    "showTurnDuration":  false,
    "cleanupPeriodDays":  30,
    "env":  {
                "CLAUDE_CODE_USE_POWERSHELL_TOOL":  "1"
            },
    "attribution":  {
                        "commit":  "$message\n\nCo-Authored-By: Claude \u003cnoreply@anthropic.com\u003e",
                        "pr":  "Generated with Claude Code"
                    },
    "hooks":  {
                  "SessionStart":  [
                                       {
                                           "hooks":  [
                                                         {
                                                             "type":  "command",
                                                             "command":  "\"C:/Program Files/Git/bin/bash.exe\" \"$env:USERPROFILE/.claude/hooks/claudemd-scanner.sh\"",
                                                             "timeout":  5
                                                         }
                                                     ]
                                       },
                                       {
                                           "hooks":  [
                                                         {
                                                             "type":  "command",
                                                             "command":  "\"C:/Program Files/Git/bin/bash.exe\" \"$env:USERPROFILE/.claude/hooks/mcp-config-integrity.sh\"",
                                                             "timeout":  5
                                                         }
                                                     ]
                                       }
                                   ],
                  "PreToolUse":  [
                                     {
                                         "matcher":  "Bash|Edit|Write",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "\"C:/Program Files/Git/bin/bash.exe\" \"$env:USERPROFILE/.claude/hooks/dangerous-actions-blocker.sh\"",
                                                           "timeout":  5
                                                       }
                                                   ]
                                     },
                                     {
                                         "matcher":  ".*",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "\"C:/Program Files/Git/bin/bash.exe\" \"$env:USERPROFILE/.claude/hooks/unicode-injection-scanner.sh\"",
                                                           "timeout":  5
                                                       }
                                                   ]
                                     }
                                 ],
                  "PostToolUse":  [
                                      {
                                          "matcher":  ".*",
                                          "hooks":  [
                                                        {
                                                            "type":  "command",
                                                            "command":  "\"C:/Program Files/Git/bin/bash.exe\" \"$env:USERPROFILE/.claude/hooks/output-secrets-scanner.sh\"",
                                                            "async":  true,
                                                            "timeout":  5
                                                        }
                                                    ]
                                      }
                                  ]
              },
    "statusLine":  {
                       "type":  "command",
                       "command":  "python \"$env:USERPROFILE/.claude/scripts/statusline.py\""
                   }
}